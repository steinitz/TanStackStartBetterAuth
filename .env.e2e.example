# E2E test configuration
# Copy this file to .env.e2e and fill in the placeholders before running pnpm test:e2e.
# Keep real keys in .env.e2e only; this example is tracked and must stay secret-free.
# Every key in this template is owned by the E2E contract. Optional keys may be
# omitted from .env.e2e; the loader then clears any inherited shell value.

PLAYWRIGHT_RUNNING=true

# Better Auth
BETTER_AUTH_SECRET=replace_with_local_test_secret
BETTER_AUTH_URL=http://localhost:3019
BETTER_AUTH_ADDITIONAL_TRUSTED_ORIGINS=http://localhost:3019
# Ordinary fixtures must not gain admin role according to creation order.
FIRST_USER_IS_ADMIN=false
# Managed as empty so an inherited shell value cannot create an environment admin.
ADMIN_USER_IDS=

# Test server and database
DATABASE_URL=http://127.0.0.1:8081
TURSO_AUTH_TOKEN=
PORT=3019
COMPATIBILITY_DATE=2025-08-10

# SMTP via local Mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=test
SMTP_PASSWORD=test
SMTP_FROM_ADDRESS=test@example.com
SMTP_FROM_NAME=Test App
SMTP_REPLY_TO_ADDRESS=test@example.com
SMTP_REPLY_TO_NAME=Test App

# Application metadata
COMPANY_NAME=STZDev
APP_NAME=TanStack Start and Better Auth
SUPPORT_EMAIL_ADDRESS=support@stzdev.com
CONTACT_EMAIL=
CONTACT_ADDRESS=
REFUND_POLICY_URL=/legal/refunds
COPYRIGHT_START_YEAR=2025
SUPPORT_LINK_TEXT=Contact our Support Team
SUPPORT_LINK_URL=/contact
PRODUCTION_HOST=

# Cloudflare Turnstile dummy test keys
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Credits and bank transfer
CREDIT_PRICE_AUD=1.50
MIN_CREDITS_PURCHASE=10
DAILY_GRANT_CREDITS=100
WELCOME_GRANT_CREDITS=500
DEFAULT_CREDITS_PURCHASE=5000
BANK_TRANSFER_BSB=000-000
BANK_TRANSFER_ACC=00000000

# Stripe test mode
# Leave disabled to run the non-Stripe E2E suite and skip the card spec loudly.
# Set IS_STRIPE_ENABLED=true and paste real test-mode keys to include the Stripe E2E.
IS_STRIPE_ENABLED=false
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional server-only Stripe charge floor; defaults to 50 when empty.
STRIPE_MIN_CENTS=

# E2E test configuration
# Copy this file to .env.test and fill in the placeholders before running pnpm test:e2e.
# Keep real keys in .env.test only; this example is tracked and must stay secret-free.

PLAYWRIGHT_RUNNING=true

# Better Auth
BETTER_AUTH_SECRET=replace_with_local_test_secret
BETTER_AUTH_URL=http://localhost:3019
BETTER_AUTH_BASE_URL=http://localhost:3019
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3019

# Test server and database
DATABASE_URL=file:test-e2e.db
PORT=3019
TEST_BASE_PROTOCOL=http
COMPATIBILITY_DATE=2025-08-10

# SMTP via local Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=test
SMTP_PASSWORD=test
SMTP_FROM_ADDRESS=test@example.com
SMTP_FROM_NAME=Test App
SMTP_REPLY_TO_ADDRESS=test@example.com
SMTP_REPLY_TO_NAME=Test App

# Application metadata
COMPANY_NAME=STZDev
APP_NAME=TanStack Start and Better Auth
SUPPORT_EMAIL_ADDRESS=support@stzdev.com

# Cloudflare Turnstile dummy test keys
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Credits and bank transfer
CREDIT_PRICE_AUD=1.50
MIN_CREDITS_PURCHASE=10
DAILY_GRANT_CREDITS=100
WELCOME_GRANT_CREDITS=500
DEFAULT_CREDITS_PURCHASE=5000
BANK_TRANSFER_BSB=000-000
BANK_TRANSFER_ACC=00000000

# Stripe test mode
# Leave disabled to run the non-Stripe E2E suite and skip the card spec loudly.
# Set IS_STRIPE_ENABLED=true and paste real test-mode keys to include the Stripe E2E.
IS_STRIPE_ENABLED=false
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional server-only Stripe charge floor; defaults to 50 if unset.
# STRIPE_MIN_CENTS=50
